{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tosstome",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The API only. To serve a website from the same Worker, add an "assets" block with "binding": "ASSETS".
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "INBOX", "class_name": "Inbox" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Relay", "Inbox"] }]
}
