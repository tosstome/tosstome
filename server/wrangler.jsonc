{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tosstome",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The browser client in web/ is served for every path outside /api/. It imports shared/, which the build step
  // copies into web/shared/ before every `wrangler dev` and `wrangler deploy`.
  "build": { "command": "node ../web/build.mjs" },
  "assets": { "directory": "../web", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "INBOX", "class_name": "Inbox" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Relay", "Inbox"] }]
}
